#define LAYER_MAIN 0
#define LAYER_SYMB 1
#define LAYER_GAMING 2
#define LAYER_MIRROR 3

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        // "i" normally, but when command is held, turns into up arrow.
        iup: i_up {
            compatible = "zmk,behavior-mod-morph";
            label = "I_UP";
            #binding-cells = <0>;
            bindings = <&kp I>, <&kp UP>;
            mods = <(MOD_LCTL)>;
        };
         // "j" normally, but when command is held, turns into left arrow. when command is held and double tap j, then home
        jleft: j_left {
            compatible = "zmk,behavior-mod-morph";
            label = "J_LEFT";
            #binding-cells = <0>;
            bindings = <&kp J>, <&kp LEFT>;
            mods = <(MOD_LCTL)>;
        };
         // "k" normally, but when command is held, turns into down arrow. 
        kdown: k_down {
            compatible = "zmk,behavior-mod-morph";
            label = "K_DOWN";
            #binding-cells = <0>;
            bindings = <&kp K>, <&kp DOWN>;
            mods = <(MOD_LCTL)>;
        };
         // "l" normally, but when command is held, turns into right arrow. when command is held and double tap l, then end
        lright: l_right {
            compatible = "zmk,behavior-mod-morph";
            label = "L_RIGHT";
            #binding-cells = <0>;
            bindings = <&kp L>, <&kp RIGHT>;
            mods = <(MOD_LCTL)>;
        };
        // grave normally, but when mod, turns into esc.
        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            label = "GRAVE_ESCAPE";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>, <&kp ESC>;
            mods = <(MOD_LCTL|MOD_RCTL|MOD_RALT)>;
        };

        td_copy_cut: tap_dance_copy_cut {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_COPY_CUT";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LC(C)>, <&kp LC(X)>;
        };

        gqt: global-quick-tap {
            compatible = "zmk,behavior-hold-tap";
            label = "GLOBAL_QUICK_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <75>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
        
        td_a: tap_dance_a {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_A";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp A>, <&kp LC(A)>;
        };

        td_s: tap_dance_s {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_S";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp S>, <&kp LC(S)>;
        };

        //mod tap nested inside tap dance
        //This example configures a mod-tap inside a tap-dance named td_mt that outputs z on a single tap, LCTRL on a single press and hold, and LCTRL and z when the tap-dance is pressed twice.
        td_mt_z: tap_dance_mod_tap_z {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_MOD_TAP_Z";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LCTRL Z>, <&kp LC(Z)>;
        };


        // KVM macros for Monoprice Blackbird 4x1 (42646): each sends ScrollLock ScrollLock + key within 5s.
        // Blue keys: direct PC1-4. Top gap: cycle next/prev.
        ZMK_MACRO(kvm_pc1,
            wait-ms = <50>;
            tap-ms = <50>;
            bindings = <&kp SCROLLLOCK>, <&kp SCROLLLOCK>, <&kp NUMBER_1>;
        )
        ZMK_MACRO(kvm_pc2,
            wait-ms = <50>;
            tap-ms = <50>;
            bindings = <&kp SCROLLLOCK>, <&kp SCROLLLOCK>, <&kp NUMBER_2>;
        )
        ZMK_MACRO(kvm_pc3,
            wait-ms = <50>;
            tap-ms = <50>;
            bindings = <&kp SCROLLLOCK>, <&kp SCROLLLOCK>, <&kp NUMBER_3>;
        )
        ZMK_MACRO(kvm_pc4,
            wait-ms = <50>;
            tap-ms = <50>;
            bindings = <&kp SCROLLLOCK>, <&kp SCROLLLOCK>, <&kp NUMBER_4>;
        )
        ZMK_MACRO(kvm_next,
            wait-ms = <50>;
            tap-ms = <50>;
            bindings = <&kp SCROLLLOCK>, <&kp SCROLLLOCK>, <&kp RIGHT_ARROW>;
        )
        ZMK_MACRO(kvm_prev,
            wait-ms = <50>;
            tap-ms = <50>;
            bindings = <&kp SCROLLLOCK>, <&kp SCROLLLOCK>, <&kp LEFT_ARROW>;
        )
    };
};

/ {
	keymap {
		compatible = "zmk,keymap";
		layer_0 {
			bindings = <
				&bootloader
				&gresc             &kp NUMBER_1    &kp NUMBER_2 &kp NUMBER_3 &kp NUMBER_4   &kp NUMBER_5  &kp LS(LC(NUMBER_4)) &kp EQUAL         &kp NUMBER_6  &kp NUMBER_7   &kp NUMBER_8    &kp NUMBER_9     &kp NUMBER_0            &kp MINUS
				&kp DELETE         &kp Q           &kp W        &kp E        &kp R          &kp T         &to LAYER_MAIN       &to LAYER_SYMB    &kp Y         &kp U          &iup            &kp O            &kp P                   &kp BACKSLASH
				&kp LEFT_CONTROL   &kp A           &kp S        &kp D        &kp F          &kp G                                                &kp H         &jleft         &kdown          &lright          &kp SEMICOLON           &kp SINGLE_QUOTE
				&kp LEFT_SHIFT     &kp Z           &kp X        &kp C        &kp V          &kp B         &kp LS(LC(LEFT_ALT)) &tog LAYER_GAMING &kp N         &kp M          &kp COMMA       &kp PERIOD       &mt RIGHT_CONTROL SLASH &kp RIGHT_SHIFT
				&kp LC(LA(DELETE)) &kp PRINTSCREEN &caps_word   &kp UP_ARROW &kp DOWN_ARROW                                                                    &kp LEFT_ARROW &kp RIGHT_ARROW &kp LEFT_BRACKET &kp RIGHT_BRACKET       &kp LEFT_GUI
				                                                                            &td_copy_cut  &kp LC(V)            &kp RIGHT_CONTROL &kp RIGHT_ALT
				                                                             &kp SPACE      &kp BACKSPACE &kp HOME             &kp PAGE_UP       &kp TAB       &kp RETURN
				                                                                                          &kp END              &kp PAGE_DOWN
			>;
		};
		layer_1 {
			bindings = <
			&bootloader
			&kvm_pc1 &kp F1 &kp F2 &kp F3 &kp F4 &kt F5 &kvm_next &kvm_prev &kp F6 &kt F7 &kp F8 &kp F9 &kp F10 &kp F11
			&kvm_pc2 &bt BT_PRV &kp UP_ARROW &bt BT_NXT &bt BT_CLR &bt BT_CLR_ALL &to LAYER_MAIN &to LAYER_SYMB &kp KP_MULTIPLY &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &kp KP_PLUS &kp F12
			&kvm_pc3 &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &out OUT_USB &out OUT_BLE &kp KP_DIVIDE &kp NUMBER_4 &kp NUMBER_5 &kp NUMBER_6 &kp KP_MINUS &mmv MOVE_UP
			&kvm_pc4 &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_HUI &rgb_ug RGB_HUD &rgb_ug RGB_EFF &msc SCRL_UP &mmv MOVE_LEFT &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &mmv MOVE_DOWN &mmv MOVE_RIGHT
			&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp NUMBER_0 &kp PERIOD &mkp LCLK &mkp RCLK &msc SCRL_DOWN
			&trans &trans &trans &trans
			&trans &trans &trans &trans &trans &trans
			&trans &trans
		>;
		};
		layer_2 {
			bindings = <
				&bootloader
				&gresc           &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp NUMBER_4   &kp NUMBER_5  &kp PRINTSCREEN &kp EQUAL         &kp NUMBER_6  &kp NUMBER_7   &kp NUMBER_8    &kp NUMBER_9     &kp NUMBER_0            &kp MINUS
				&kp DELETE       &kp Q        &kp W        &kp E        &kp R          &kp T         &to LAYER_MAIN  &to LAYER_SYMB    &kp Y         &kp U          &kp I           &kp O            &kp P                   &kp BACKSLASH
				&kp LEFT_CONTROL &kp A        &kp S        &kp D        &kp F          &kp G                                           &kp H         &kp J          &kp K           &kp L            &kp SEMICOLON           &kp SINGLE_QUOTE
				&kp LEFT_SHIFT   &kp Z        &kp X        &kp C        &kp V          &kp B         &tog LAYER_MAIN &tog LAYER_SYMB   &kp N         &kp M          &kp COMMA       &kp PERIOD       &mt RIGHT_CONTROL SLASH &kp RIGHT_SHIFT
				&none            &none        &caps_word   &kp UP_ARROW &kp DOWN_ARROW                                                               &kp LEFT_ARROW &kp RIGHT_ARROW &kp LEFT_BRACKET &kp RIGHT_BRACKET       &none
				                                                                       &kp LC(C)     &kp LC(V)       &kp RIGHT_CONTROL &kp RIGHT_ALT
				                                                        &kp SPACE      &kp BACKSPACE &kp HOME        &kp PAGE_UP       &kp TAB       &kp RETURN
				                                                                                     &kp END         &kp PAGE_DOWN
			>;
		};
		layer_3 {
			bindings = <
				&bootloader
				&gresc         &kp NUMBER_6 &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9   &kp NUMBER_0  &kp PRINTSCREEN &kp EQUAL         &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3    &kp NUMBER_4     &kp NUMBER_5      &kp MINUS
				&kp DELETE     &kp Y        &kp U        &kp I        &kp O          &kp P         &to LAYER_MAIN  &to LAYER_SYMB    &kp Q         &kp W          &kp E           &kp R            &kp T             &kp BACKSLASH
				&kp BACKSPACE  &kp H        &kp J        &kp K        &kp L          &kp SEMICOLON                                   &kp A         &kp S          &kp D           &kp F            &kp G             &kp SINGLE_QUOTE
				&kp LEFT_SHIFT &kp N        &kp M        &kp COMMA    &kp PERIOD     &kp SLASH     &tog LAYER_MAIN &tog LAYER_SYMB   &kp Z         &kp X          &kp C           &kp V            &kp B             &kp RIGHT_SHIFT
				&none          &none        &caps_word   &kp UP_ARROW &kp DOWN_ARROW                                                               &kp LEFT_ARROW &kp RIGHT_ARROW &kp LEFT_BRACKET &kp RIGHT_BRACKET &none
				                                                                     &kp LC(C)     &kp LC(V)       &kp RIGHT_CONTROL &kp RIGHT_ALT
				                                                      &kp SPACE      &kp BACKSPACE &kp HOME        &kp PAGE_UP       &kp TAB       &kp RETURN
				                                                                                   &kp END         &kp PAGE_DOWN
			>;
		};
	};
};
